<Window x:Class="NTOobs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NTOobs"
        Width="1040" Height="700" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center">
                <RadioButton x:Name="NavPanel" Style="{StaticResource NavButton}" Content="&#xE80F;" ToolTip="Painel" Tag="0" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavShortcuts" Style="{StaticResource NavButton}" Content="&#xE765;" ToolTip="Atalhos e perfis" Tag="1" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavMacros" Style="{StaticResource NavButton}" Content="&#xE768;" ToolTip="Macros" Tag="5" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSounds" Style="{StaticResource NavButton}" Content="&#xE995;" ToolTip="Soundboard" Tag="6" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavMusic" Style="{StaticResource NavButton}" Content="&#xE8D6;" ToolTip="Música da live" Tag="4" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavTools" Style="{StaticResource NavButton}" Content="&#xE90F;" ToolTip="Ferramentas: contadores, replay, começar live, marcadores" Tag="7" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavTwitch" Style="{StaticResource NavButton}" Content="&#xE8BD;" ToolTip="Twitch: chat e alertas" Tag="8" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavPhone" Style="{StaticResource NavButton}" Content="&#xE8EA;" ToolTip="Controle pelo celular" Tag="9" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavConnection" Style="{StaticResource NavButton}" Content="&#xE774;" ToolTip="Conexão com o OBS" Tag="2" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavLog" Style="{StaticResource NavButton}" Content="&#xE8A5;" ToolTip="Registro" Tag="3" Checked="Nav_Checked"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
                <DockPanel>
                    <Button x:Name="BtnTheme" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Content="&#xE706;" ToolTip="Alternar tema claro/escuro" Click="BtnTheme_Click"/>
                    <Border DockPanel.Dock="Right" Margin="0,0,10,0" Padding="10,4" CornerRadius="12"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PillDot" Width="7" Height="7" Fill="{DynamicResource Danger}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtStatusPill" Text="Desconectado" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="NTOobs" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Controle do OBS por teclas" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">

                <!-- PÁGINA 0: Painel -->
                <ScrollViewer x:Name="PagePanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24" MaxWidth="1100">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Hover}" Margin="0,0,12,0">
                                        <TextBlock x:Name="StatusIcon" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="{DynamicResource Danger}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="OBS" Style="{StaticResource CapsText}"/>
                                        <TextBlock x:Name="TxtStatusBig" Text="Desconectado" FontSize="16" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Hover}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="{DynamicResource Ok}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ATALHOS DISPARADOS NESTA SESSÃO" Style="{StaticResource CapsText}"/>
                                        <TextBlock x:Name="TxtFiredTotal" Text="0" FontSize="20" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Hover}" Margin="0,0,12,0">
                                        <TextBlock x:Name="LiveIcon" Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="SAÚDE DA LIVE" Style="{StaticResource CapsText}"/>
                                        <TextBlock x:Name="TxtHealthState" Text="Fora do ar" FontSize="16" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DockPanel>
                                <UniformGrid Columns="5" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="TEMPO NO AR" Style="{StaticResource CapsText}"/>
                                        <TextBlock x:Name="TxtHTime" Text="--" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="BITRATE" Style="{StaticResource CapsText}"/>
                                        <TextBlock x:Name="TxtHKbps" Text="--" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="QUADROS PERDIDOS" Style="{StaticResource CapsText}"/>
                                        <TextBlock x:Name="TxtHDrop" Text="--" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="CPU" Style="{StaticResource CapsText}"/>
                                        <TextBlock x:Name="TxtHCpu" Text="--" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="FPS" Style="{StaticResource CapsText}"/>
                                        <TextBlock x:Name="TxtHFps" Text="--" FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock x:Name="TxtHealthAlert" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"
                                           Margin="0,12,0,0" Visibility="Collapsed"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="BtnGoLive" Content="Começar live" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="BtnGoLive_Click"/>
                                    <Button x:Name="BtnSkipCountdown" Content="Pular contagem" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnSkipCountdown_Click"/>
                                    <Button Content="Marcar momento" Margin="0,0,8,0" Click="BtnMarker_Click"/>
                                    <Button Content="Replay instantâneo" Margin="0,0,8,0" Click="BtnReplayTest_Click"/>
                                    <Button Content="Encerrar live" Click="BtnEndLive_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Padding="0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="16,16,16,12">
                                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Hover}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtProfilePanel" Text="Atalhos configurados" FontWeight="SemiBold"/>
                                        <TextBlock Text="Cada tecla dispara uma ação no OBS. Os contadores valem desde que você abriu o app."
                                                   Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </StackPanel>

                                <ItemsControl x:Name="PanelList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding KeyName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding FiredText}" FontSize="11"
                                                               VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Fired}" Value="0">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Button Grid.Column="2" Content="Ver" Click="RowView_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="TxtEmptyPanel" Text="Nenhum atalho ainda. Abra a aba Atalhos e crie o primeiro."
                                           Style="{StaticResource MutedText}" Margin="16,4,16,16"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PÁGINA 1: Atalhos -->
                <ScrollViewer x:Name="PageShortcuts" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="24" MaxWidth="1100">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Perfis (um para cada jogo)" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                                           Text="Cada perfil tem as suas próprias teclas. Clique em um perfil para ativá-lo. As teclas abaixo são do perfil ativo."/>
                                <ListBox x:Name="ListProfiles" MaxHeight="130" Margin="0,10,0,8" SelectionChanged="ListProfiles_SelectionChanged"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Excluir" Margin="6,0,0,0" Click="BtnProfileDelete_Click"/>
                                    <Button DockPanel.Dock="Right" Content="Renomear" Margin="6,0,0,0" Click="BtnProfileRename_Click"/>
                                    <Button DockPanel.Dock="Right" Content="Novo perfil" Margin="6,0,0,0" Click="BtnProfileNew_Click"/>
                                    <TextBox x:Name="TxtProfileName" ToolTip="Nome do perfil (ex.: Valorant)"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="JOGO DESTE PERFIL" Style="{StaticResource CapsText}" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Escolher programa aberto" Margin="6,0,0,0" Click="BtnProfilePickGame_Click"/>
                                    <TextBox x:Name="TxtProfileExe" ToolTip="Nome do processo do jogo, sem .exe (ex.: VALORANT-Win64-Shipping)"
                                             LostFocus="TxtProfileExe_LostFocus"/>
                                </DockPanel>
                                <ListBox x:Name="ListProcesses" MaxHeight="140" Margin="0,6,0,0" Visibility="Collapsed"
                                         SelectionChanged="ListProcesses_SelectionChanged"/>
                                <CheckBox x:Name="ChkAutoProfile" Margin="0,10,0,0" Click="ChkAutoProfile_Click"
                                          Content="Trocar de perfil sozinho quando o jogo estiver na tela"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                           Text="Abra o jogo, volte aqui e clique em Escolher programa aberto. Quando o jogo ficar na frente, o NTOobs ativa este perfil."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="350"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Atalhos" FontWeight="SemiBold" Margin="16,16,16,12"/>
                                <ItemsControl x:Name="ListBindings">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding KeyName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Content="Testar" Click="RowTest_Click" Margin="0,0,6,0"/>
                                                        <Button Content="Remover" Click="RowRemove_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="TxtEmptyList" Text="Nenhum atalho ainda. Use o formulário ao lado."
                                           Style="{StaticResource MutedText}" Margin="16,4,16,16"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="NOVO ATALHO" Style="{StaticResource CapsText}" Margin="0,0,0,10"/>

                                <TextBlock Text="1. Tecla (qualquer tecla, de qualquer teclado)"/>
                                <Button x:Name="BtnCapture" Content="Capturar tecla" Margin="0,6,0,6" Click="BtnCapture_Click"/>
                                <TextBlock x:Name="TxtCaptured" Text="Nenhuma tecla capturada" Foreground="{DynamicResource Muted}"/>
                                <CheckBox x:Name="ChkOnlyDevice" Content="Somente neste teclado" IsEnabled="False" Margin="0,8,0,16"/>

                                <TextBlock Text="2. Ação" Margin="0,0,0,8"/>
                                <StackPanel x:Name="ActionChoices" Margin="0,0,0,16"/>

                                <TextBlock x:Name="TxtTargetLabel" Text="3. Nome da cena:"/>
                                <TextBox x:Name="TxtTarget" Margin="0,6,0,8"/>
                                <Button x:Name="BtnCaptureCombo" Content="Capturar combinação (aperte as teclas)" Visibility="Collapsed"
                                        Margin="0,0,0,8" Click="BtnCaptureCombo_Click"/>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="Atualizar" Padding="8,3" Click="BtnRefresh_Click"/>
                                    <TextBlock x:Name="TxtListLabel" Text="Cenas do OBS (clique para usar)" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBox x:Name="TxtFilter" Margin="0,0,0,6" Visibility="Collapsed" ToolTip="Filtrar a lista (ex.: backtrack)" TextChanged="TxtFilter_TextChanged"/>
                                <ListBox x:Name="ListScenes" MaxHeight="160" Margin="0,0,0,16" SelectionChanged="ListScenes_SelectionChanged"/>

                                <Button x:Name="BtnAdd" Content="Adicionar atalho" Style="{StaticResource PrimaryButton}" Click="BtnAdd_Click"/>

                                <TextBlock Style="{StaticResource MutedText}" Margin="0,14,0,0"
                                           Text="Dica: teclas F13 a F24, ou um teclado/macropad externo, evitam conflito com o que você digita durante a live."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- PÁGINA 4: Música da live -->
                <ScrollViewer x:Name="PageMusic" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="24" MaxWidth="1100">
                        <Border Style="{StaticResource CardBorder}" MaxWidth="640" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Música da live" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,14"
                                           Text="Cole o link de uma playlist do YouTube ou do Spotify. O som entra no mixer de áudio do OBS e continua em todas as cenas. Spotify toca pelo aplicativo do computador, com as músicas inteiras."/>

                                <TextBlock Text="Link da playlist" Style="{StaticResource CapsText}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtMusicUrl"/>

                                <TextBlock Text="Volume (YouTube)" Style="{StaticResource CapsText}" Margin="0,14,0,4"/>
                                <DockPanel>
                                    <TextBlock x:Name="TxtVolValue" DockPanel.Dock="Right" Width="40" TextAlignment="Right" Text="60%"/>
                                    <Slider x:Name="SldVolume" Minimum="0" Maximum="100" ValueChanged="SldVolume_ValueChanged"
                                            LostMouseCapture="SldVolume_Done"/>
                                </DockPanel>

                                <CheckBox x:Name="ChkMusicLoop" Content="Repetir a playlist (YouTube)" Margin="0,14,0,6"/>
                                <CheckBox x:Name="ChkMusicShuffle" Content="Ordem aleatória (YouTube)"/>

                                <TextBlock Text="Tecla para pausar / retomar a música" Style="{StaticResource CapsText}" Margin="0,18,0,4"/>
                                <DockPanel>
                                    <Button x:Name="BtnMusicKeyClear" DockPanel.Dock="Right" Content="Remover" Margin="8,0,0,0" Click="BtnMusicKeyClear_Click"/>
                                    <Button x:Name="BtnMusicKey" DockPanel.Dock="Right" Content="Definir tecla" Margin="8,0,0,0" Click="BtnMusicKey_Click"/>
                                    <TextBlock x:Name="TxtMusicKey" Text="Nenhuma tecla definida" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <CheckBox x:Name="ChkMusicOnlyDevice" Margin="0,8,0,0"
                                          Content="Somente no teclado em que eu apertar (útil para teclado externo)"/>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="BtnMusicStart" Content="Iniciar / aplicar" Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,8,0" Click="BtnMusicStart_Click"/>
                                    <Button Content="Pausar / retomar" Margin="0,0,8,0" Click="BtnMusicToggle_Click"/>
                                    <Button Content="Parar e remover do OBS" Click="BtnMusicStop_Click"/>
                                </StackPanel>

                                <TextBlock x:Name="TxtMusicStatus" Text="Música desligada" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" MaxWidth="640" HorizontalAlignment="Left" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Como funciona" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6"
                                           Text="• YouTube: o NTOobs cria no OBS a fonte &quot;NTOobs Música&quot; e a coloca em todas as cenas (fora da tela), então a música não corta ao trocar de cena. Se você fechar o NTOobs, ela continua tocando."/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6"
                                           Text="• Spotify: o NTOobs abre a playlist no aplicativo Spotify (precisa estar instalado e com a sua conta) e cria no OBS a fonte &quot;NTOobs Spotify&quot;, que captura só o som do Spotify, em todas as cenas. As músicas tocam inteiras. Se a playlist abrir sem tocar, clique no play verde dela uma vez."/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6"
                                           Text="• O som aparece no Mixer de áudio do OBS com o nome da fonte. Ajuste o volume ou silencie por lá. No Spotify, repetir, aleatório e volume são definidos no próprio aplicativo."/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6"
                                           Text="• Para pausar/retomar com uma tecla: clique em Definir tecla acima e aperte a tecla que quiser, em qualquer teclado. Ela também aparece na aba Atalhos."/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6"
                                           Text="• O atalho de pausar/retomar funciona com o NTOobs aberto (pode ficar minimizado). Com o Spotify, ele pausa só o Spotify, sem mexer em outros players."/>
                                <TextBlock Style="{StaticResource MutedText}"
                                           Text="• Cuidado com direitos autorais: músicas protegidas podem silenciar ou derrubar suas transmissões e VODs."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PÁGINA 5: Macros -->
                <ScrollViewer x:Name="PageMacros" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Grid Margin="24" MaxWidth="1100">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Macros" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,10"
                                           Text="Uma tecla, várias ações em sequência. Exemplo: Volto já = Alternar cena (Volto já) + Mutar o microfone + Pausar a música. Apertando de novo, tudo volta."/>
                                <ListBox x:Name="ListMacros" MinHeight="80" MaxHeight="260" SelectionChanged="ListMacros_SelectionChanged"/>
                                <TextBlock Text="NOVA MACRO" Style="{StaticResource CapsText}" Margin="0,14,0,4"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Criar" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Click="BtnMacroNew_Click"/>
                                    <TextBox x:Name="TxtMacroName" ToolTip="Nome da macro (ex.: Volto já)"/>
                                </DockPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Criar exemplo Volto já" Margin="0,0,6,6" Click="BtnMacroExample_Click"/>
                                    <Button Content="Excluir macro" Margin="0,0,6,6" Click="BtnMacroDelete_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock x:Name="TxtMacroTitle" Text="Selecione ou crie uma macro" FontWeight="SemiBold"/>
                                <ItemsControl x:Name="ListSteps" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,7">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Content="&#xE70E;" Style="{StaticResource IconButton}" ToolTip="Subir" Click="StepUp_Click"/>
                                                        <Button Content="&#xE70D;" Style="{StaticResource IconButton}" ToolTip="Descer" Click="StepDown_Click"/>
                                                        <Button Content="&#xE711;" Style="{StaticResource IconButton}" ToolTip="Remover" Click="StepRemove_Click"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="TxtNoSteps" Text="Nenhum passo ainda. Adicione abaixo." Style="{StaticResource MutedText}" Margin="0,6,0,0"/>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ADICIONAR PASSO: AÇÃO" Style="{StaticResource CapsText}" Margin="0,0,0,4"/>
                                        <ListBox x:Name="ListStepAction" Height="200" DisplayMemberPath="Label" SelectionChanged="ListStepAction_SelectionChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="TxtStepTargetLabel" Text="Destino:" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtStepTarget"/>
                                        <ListBox x:Name="ListStepSuggest" MaxHeight="110" Margin="0,6,0,0" SelectionChanged="ListStepSuggest_SelectionChanged"/>
                                        <DockPanel Margin="0,8,0,0">
                                            <TextBox x:Name="TxtStepDelay" DockPanel.Dock="Right" Width="80" Text="0"/>
                                            <TextBlock Text="Esperar depois (milissegundos)" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                                        </DockPanel>
                                        <Button Content="Adicionar passo" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Click="BtnStepAdd_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="TECLA DA MACRO (PERFIL ATIVO)" Style="{StaticResource CapsText}" Margin="0,18,0,4"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Testar macro" Margin="6,0,0,0" Click="BtnMacroTest_Click"/>
                                    <Button x:Name="BtnMacroKey" DockPanel.Dock="Right" Content="Definir tecla" Margin="6,0,0,0" Click="BtnMacroKey_Click"/>
                                    <TextBlock x:Name="TxtMacroKey" Text="Nenhuma tecla" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                                </DockPanel>
                                <CheckBox x:Name="ChkMacroOnlyDevice" Margin="0,8,0,0"
                                          Content="Somente no teclado em que eu apertar (útil para teclado externo)"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- PÁGINA 6: Soundboard -->
                <ScrollViewer x:Name="PageSounds" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="24" MaxWidth="1100">
                        <Border Style="{StaticResource CardBorder}" Padding="0">
                            <StackPanel>
                                <StackPanel Margin="16,16,16,8">
                                    <TextBlock Text="Soundboard" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,10"
                                               Text="Efeitos e memes que tocam na live por uma tecla. O som sai pela fonte &quot;NTOobs Soundboard&quot; do OBS (aparece no mixer). Arquivos aceitos: mp3, wav, ogg, m4a."/>
                                    <WrapPanel>
                                        <Button Content="Adicionar sons..." Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Click="BtnSoundAdd_Click"/>
                                        <Button Content="Parar som" Margin="0,0,8,6" Click="BtnSoundStop_Click"/>
                                    </WrapPanel>
                                    <CheckBox x:Name="ChkSoundMonitor" Margin="0,6,0,0" Click="ChkSoundMonitor_Click"
                                              Content="Ouvir os sons no meu fone também (monitoramento do OBS)"/>
                                    <CheckBox x:Name="ChkSoundOnlyDevice" Margin="0,8,0,0"
                                              Content="Ao definir tecla: somente no teclado em que eu apertar"/>
                                    <TextBlock x:Name="TxtSoundHint" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                               Text="Se o som sair duplicado na live, desmarque o monitoramento (o Áudio do Desktop pode estar capturando o seu fone)."/>
                                </StackPanel>
                                <ItemsControl x:Name="ListSounds">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Info}" Style="{StaticResource MutedText}"/>
                                                    </StackPanel>
                                                    <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding VolumeText}" Width="38" TextAlignment="Right"/>
                                                        <Slider Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" LostMouseCapture="SoundVolume_Done"/>
                                                    </DockPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Content="Tocar" Margin="0,0,6,0" Click="SoundPlay_Click"/>
                                                        <Button Content="Tecla" Margin="0,0,6,0" Click="SoundKey_Click"/>
                                                        <Button Content="Remover" Click="SoundRemove_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="TxtNoSounds" Text="Nenhum som ainda. Clique em Adicionar sons."
                                           Style="{StaticResource MutedText}" Margin="16,4,16,16"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PÁGINA 7: Ferramentas -->
                <ScrollViewer x:Name="PageTools" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="24" MaxWidth="1100">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <!-- Estilo dos textos -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Estilo dos textos na live" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,12"
                                                   Text="Tipo de letra, tamanho e cor dos contadores e da contagem do Começar live (a contagem fica 1,5x maior). Os alertas da Twitch usam o mesmo tipo de letra. Clique em Aplicar para atualizar os textos que já estão no OBS."/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="TIPO DE LETRA" Style="{StaticResource CapsText}" Margin="0,0,0,4"/>
                                                <TextBox x:Name="TxtFontFilter" ToolTip="Procurar fonte (ex.: Arial, Impact)" TextChanged="TxtFontFilter_TextChanged"/>
                                                <ListBox x:Name="ListFonts" Height="170" Margin="0,6,0,0" SelectionChanged="ListFonts_SelectionChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="TAMANHO" Style="{StaticResource CapsText}" Margin="0,0,0,4"/>
                                                <DockPanel>
                                                    <TextBlock x:Name="TxtFontSizeValue" DockPanel.Dock="Right" Width="36" TextAlignment="Right" Text="64"/>
                                                    <Slider x:Name="SldFontSize" Minimum="12" Maximum="200" ValueChanged="SldFontSize_ValueChanged"/>
                                                </DockPanel>
                                                <TextBlock Text="COR" Style="{StaticResource CapsText}" Margin="0,12,0,4"/>
                                                <WrapPanel x:Name="PanelColors"/>
                                                <DockPanel>
                                                    <TextBlock Text="Código" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource MutedText}"/>
                                                    <TextBox x:Name="TxtTextColor" ToolTip="Cor em hexadecimal (ex.: #FFFFFF)" LostFocus="TextStyle_LostFocus"/>
                                                </DockPanel>
                                                <CheckBox x:Name="ChkTextBold" Content="Negrito" Margin="0,12,0,0" Click="TextStyle_Changed"/>
                                                <CheckBox x:Name="ChkTextOutline" Content="Contorno" Margin="0,8,0,0" Click="TextStyle_Changed"/>
                                                <DockPanel Margin="0,6,0,0">
                                                    <TextBox x:Name="TxtOutlineSize" DockPanel.Dock="Right" Width="44" ToolTip="Espessura do contorno (1 a 20)" LostFocus="TextStyle_LostFocus"/>
                                                    <TextBlock Text="Espessura" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,6,0" Style="{StaticResource MutedText}"/>
                                                    <TextBox x:Name="TxtOutlineColor" ToolTip="Cor do contorno (ex.: #000000)" LostFocus="TextStyle_LostFocus"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Grid>
                                        <Border Background="#3A3A42" CornerRadius="8" Padding="12" Margin="0,14,0,0" MinHeight="70">
                                            <TextBlock x:Name="TxtFontPreview" Text="Mortes: 7" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Border>
                                        <Button Content="Aplicar nos textos do OBS" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                                HorizontalAlignment="Left" Click="BtnApplyTextStyle_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Contadores -->
                                <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,16">
                                    <StackPanel>
                                        <StackPanel Margin="16,16,16,8">
                                            <TextBlock Text="Contadores na tela" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                                                       Text="Mortes, vitórias, desafios. Use as ações Contador na aba Atalhos para somar com uma tecla. Mostrar na live cria um texto no OBS que atualiza sozinho."/>
                                        </StackPanel>
                                        <ItemsControl x:Name="ListCounters">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                <Button Content="−1" Margin="0,0,4,0" Click="CounterSub_Click"/>
                                                                <Button Content="+1" Margin="0,0,4,0" Click="CounterAdd_Click"/>
                                                                <Button Content="Zerar" Margin="0,0,4,0" Click="CounterReset_Click"/>
                                                                <Button Content="Mostrar na live" Margin="0,0,4,0" Click="CounterShow_Click"/>
                                                                <Button Content="&#xE711;" Style="{StaticResource IconButton}" ToolTip="Remover" Click="CounterRemove_Click"/>
                                                            </StackPanel>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Text}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Info}" Style="{StaticResource MutedText}"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Margin="16,8,16,16">
                                            <TextBlock Text="NOVO CONTADOR" Style="{StaticResource CapsText}" Margin="0,4,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtCounterName" Grid.Column="0" ToolTip="Nome (ex.: Mortes)"/>
                                                <TextBox x:Name="TxtCounterFormat" Grid.Column="2" Text="{}{nome}: {n}"
                                                         ToolTip="Texto na live. {nome} = nome do contador, {n} = número"/>
                                                <Button Grid.Column="3" Content="Adicionar" Margin="8,0,0,0" Click="BtnCounterAdd_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Marcadores -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Marcar momento" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,10"
                                                   Text="Cada marcação salva o horário da live e da gravação num arquivo do dia, na pasta Documentos\NTOobs\Marcadores. Depois é só ir direto nos melhores momentos para cortar (TikTok, Shorts, Reels)."/>
                                        <WrapPanel>
                                            <Button Content="Marcar agora" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Click="BtnMarker_Click"/>
                                            <Button Content="Abrir pasta" Margin="0,0,8,6" Click="BtnMarkersFolder_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="TxtMarkers" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Muted}" Margin="0,6,0,0" Text="Nenhum momento marcado hoje."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <!-- Começar live -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Começar live" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,10"
                                                   Text="Confere o microfone e as cenas, inicia a transmissão, mostra &quot;Começando em 5:00&quot; na cena de início e troca para a cena principal no fim. Deixe a cena de início vazia para começar direto."/>
                                        <TextBlock Text="CENA DE INÍCIO (COM A CONTAGEM)" Style="{StaticResource CapsText}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtLiveStart" GotFocus="LivePickTarget_GotFocus" LostFocus="Tools_LostFocus"/>
                                        <TextBlock Text="CENA PRINCIPAL" Style="{StaticResource CapsText}" Margin="0,10,0,4"/>
                                        <TextBox x:Name="TxtLiveMain" GotFocus="LivePickTarget_GotFocus" LostFocus="Tools_LostFocus"/>
                                        <TextBlock Text="MICROFONE (PARA CONFERIR SE NÃO ESTÁ MUTADO)" Style="{StaticResource CapsText}" Margin="0,10,0,4"/>
                                        <TextBox x:Name="TxtLiveMic" GotFocus="LivePickTarget_GotFocus" LostFocus="Tools_LostFocus"/>
                                        <TextBlock x:Name="TxtLivePickLabel" Text="Clique num campo acima e escolha na lista:" Style="{StaticResource MutedText}" Margin="0,8,0,4"/>
                                        <ListBox x:Name="ListLivePick" MaxHeight="120" SelectionChanged="ListLivePick_SelectionChanged"/>
                                        <DockPanel Margin="0,10,0,0">
                                            <TextBox x:Name="TxtLiveCountdown" DockPanel.Dock="Right" Width="80" LostFocus="Tools_LostFocus"/>
                                            <TextBlock Text="Contagem (segundos)" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <CheckBox x:Name="ChkLiveRecord" Content="Gravar junto com a live" Margin="0,10,0,0" Click="Tools_Changed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Replay -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Replay instantâneo" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,10"
                                                   Text="Salva o Replay Buffer do OBS, mostra o vídeo em tela cheia numa cena só dele e volta para a cena anterior. No OBS: Configurações, Saída, Replay Buffer, marque Ativar e defina o tempo (ex.: 20 s)."/>
                                        <TextBlock Text="CENA DO REPLAY (CRIADA SOZINHA SE NÃO EXISTIR)" Style="{StaticResource CapsText}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtReplayScene" LostFocus="Tools_LostFocus"/>
                                        <DockPanel Margin="0,10,0,0">
                                            <TextBox x:Name="TxtReplaySeconds" DockPanel.Dock="Right" Width="80" LostFocus="Tools_LostFocus"/>
                                            <TextBlock Text="Tempo na tela (segundos, 0 = o replay inteiro)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <Button Content="Testar replay" Margin="0,10,0,0" HorizontalAlignment="Left" Click="BtnReplayTest_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Saúde -->
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Saúde da live" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,10"
                                                   Text="O Painel mostra bitrate, quadros perdidos, CPU e FPS durante a live. Se a internet ou o PC começarem a falhar, aparece um aviso."/>
                                        <CheckBox x:Name="ChkHealthBeep" Content="Tocar um som de aviso quando a live tiver problema" Click="Tools_Changed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- PÁGINA 8: Twitch -->
                <ScrollViewer x:Name="PageTwitch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="24" MaxWidth="1100">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Canal da Twitch" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,10"
                                                   Text="Só com o nome do canal, o NTOobs já lê o chat e mostra alertas de sub, raid e bits. Para responder comandos no chat e mostrar follows, entre com a Twitch (ao lado)."/>
                                        <TextBlock Text="NOME DO CANAL" Style="{StaticResource CapsText}" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <Button x:Name="BtnTwitchConnect" DockPanel.Dock="Right" Content="Conectar" Style="{StaticResource PrimaryButton}"
                                                    Margin="8,0,0,0" Click="BtnTwitchConnect_Click"/>
                                            <TextBox x:Name="TxtTwitchChannel" ToolTip="Ex.: noturninh0"/>
                                        </DockPanel>
                                        <CheckBox x:Name="ChkTwitchEnabled" Content="Conectar à Twitch ao abrir o NTOobs" Margin="0,10,0,0" Click="Twitch_Changed"/>
                                        <TextBlock x:Name="TxtTwitchStatus" Text="Desconectado" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Alertas na tela" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,10"
                                                   Text="Escolha um modelo pronto e, se quiser, coloque a sua própria imagem, GIF ou vídeo e o seu som em cada tipo de alerta. Adicionar alertas no OBS cria a fonte &quot;NTOobs Alertas&quot; em todas as cenas (só funciona com o NTOobs aberto)."/>
                                        <WrapPanel>
                                            <CheckBox x:Name="ChkAlertFollow" Content="Follow" Margin="0,0,16,6" Click="Twitch_Changed"/>
                                            <CheckBox x:Name="ChkAlertSub" Content="Sub" Margin="0,0,16,6" Click="Twitch_Changed"/>
                                            <CheckBox x:Name="ChkAlertRaid" Content="Raid" Margin="0,0,16,6" Click="Twitch_Changed"/>
                                            <CheckBox x:Name="ChkAlertBits" Content="Bits" Margin="0,0,16,6" Click="Twitch_Changed"/>
                                        </WrapPanel>

                                        <TextBlock Text="MODELO" Style="{StaticResource CapsText}" Margin="0,10,0,6"/>
                                        <UniformGrid x:Name="PanelAlertTemplates" Columns="3"/>

                                        <TextBlock Text="POSIÇÃO NA TELA" Style="{StaticResource CapsText}" Margin="0,6,0,6"/>
                                        <WrapPanel x:Name="PanelAlertPositions"/>

                                        <DockPanel Margin="0,4,0,0">
                                            <TextBox x:Name="TxtAlertDuration" DockPanel.Dock="Right" Width="60" LostFocus="AlertDuration_LostFocus"/>
                                            <TextBlock Text="Tempo na tela (segundos; vídeos tocam até o fim, no máximo 15 s)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </DockPanel>

                                        <TextBlock Text="IMAGEM E SOM DE CADA ALERTA" Style="{StaticResource CapsText}" Margin="0,14,0,4"/>
                                        <ItemsControl x:Name="ListAlertKinds">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Content="Testar" Margin="6,0,0,0" Click="AlertKindTest_Click"/>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding MediaText}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                                            <TextBlock Text="{Binding SoundText}" Style="{StaticResource MutedText}"/>
                                                            <WrapPanel Margin="0,6,0,0">
                                                                <Button Content="Imagem / GIF / vídeo..." Margin="0,0,6,4" Click="AlertKindMedia_Click"/>
                                                                <Button Content="Som..." Margin="0,0,6,4" Click="AlertKindSound_Click"/>
                                                                <Button Content="Usar o padrão" Margin="0,0,6,4" Click="AlertKindClear_Click"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="SOM PADRÃO (QUANDO O TIPO NÃO TEM SOM PRÓPRIO)" Style="{StaticResource CapsText}" Margin="0,10,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Sem som" Margin="6,0,0,0" Click="BtnAlertSoundClear_Click"/>
                                            <Button DockPanel.Dock="Right" Content="Escolher som..." Margin="6,0,0,0" Click="BtnAlertSound_Click"/>
                                            <TextBlock x:Name="TxtAlertSound" Text="Sem som" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>

                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Content="Adicionar alertas no OBS" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Click="BtnAlertsObs_Click"/>
                                            <Button Content="Ver prévia no navegador" Margin="0,0,8,6" Click="BtnAlertPreview_Click"/>
                                            <Button Content="Testar no OBS" Margin="0,0,8,6" Click="BtnAlertTest_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Entrar com a Twitch (opcional)" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,8"
                                                   Text="Feito uma vez só. 1) Abra o console da Twitch e clique em Registrar seu aplicativo. 2) Em URLs de redirecionamento OAuth, cole o endereço abaixo. 3) Categoria: Chat Bot. Tipo de cliente: Público. 4) Copie o ID do cliente e cole aqui."/>
                                        <Button Content="Abrir o console da Twitch" HorizontalAlignment="Left" Click="BtnTwitchConsole_Click"/>
                                        <TextBlock Text="URL DE REDIRECIONAMENTO" Style="{StaticResource CapsText}" Margin="0,10,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Copiar" Margin="6,0,0,0" Click="BtnTwitchCopyRedirect_Click"/>
                                            <TextBox x:Name="TxtTwitchRedirect" IsReadOnly="True"/>
                                        </DockPanel>
                                        <TextBlock Text="ID DO CLIENTE (CLIENT ID)" Style="{StaticResource CapsText}" Margin="0,10,0,4"/>
                                        <TextBox x:Name="TxtTwitchClientId" LostFocus="Twitch_LostFocus"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Entrar com a Twitch" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Click="BtnTwitchLogin_Click"/>
                                            <Button Content="Sair" Margin="0,0,8,6" Click="BtnTwitchLogout_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="TxtTwitchLogin" Text="Não conectado (somente leitura)" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardBorder}" Padding="0">
                                    <StackPanel>
                                        <StackPanel Margin="16,16,16,8">
                                            <TextBlock Text="Comandos do chat" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,8"
                                                       Text="Responder no chat precisa do login com a Twitch."/>
                                            <CheckBox x:Name="ChkCmdMusic" Content="!musica responde qual música está tocando" Margin="0,0,0,6" Click="Twitch_Changed"/>
                                            <CheckBox x:Name="ChkCmdMark" Content="!marcar (só você e moderadores) marca o momento" Click="Twitch_Changed"/>
                                        </StackPanel>
                                        <ItemsControl x:Name="ListCommands">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,8">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource IconButton}" ToolTip="Remover" Click="CommandRemove_Click"/>
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Margin="16,8,16,16">
                                            <TextBlock Text="NOVO COMANDO" Style="{StaticResource CapsText}" Margin="0,4,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtCmdName" Grid.Column="0" ToolTip="Ex.: !discord"/>
                                                <TextBox x:Name="TxtCmdResponse" Grid.Column="2" ToolTip="Resposta. {user} = nome de quem mandou"/>
                                                <Button Grid.Column="3" Content="Adicionar" Margin="8,0,0,0" Click="BtnCommandAdd_Click"/>
                                            </Grid>
                                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                                       Text="Exemplo: !discord  →  Entra no nosso Discord: discord.gg/seulink. Use {user} para chamar a pessoa pelo nome."/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- PÁGINA 9: Celular -->
                <ScrollViewer x:Name="PagePhone" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="24" MaxWidth="1100">
                        <Border Style="{StaticResource CardBorder}" MaxWidth="640" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Controle pelo celular" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,12"
                                           Text="Use o celular como um StreamDeck: botões grandes com os atalhos do perfil ativo, macros, sons, contadores e controles da live. O celular precisa estar no mesmo Wi-Fi do computador."/>
                                <CheckBox x:Name="ChkPhoneEnabled" Content="Ativar controle pelo celular" Click="ChkPhoneEnabled_Click"/>
                                <TextBlock Text="ABRA NO NAVEGADOR DO CELULAR" Style="{StaticResource CapsText}" Margin="0,14,0,4"/>
                                <TextBox x:Name="TxtPhoneUrl" IsReadOnly="True" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Copiar endereço" Margin="0,0,8,6" Click="BtnPhoneCopy_Click"/>
                                    <Button Content="Gerar novo código" Margin="0,0,8,6" Click="BtnPhoneNewKey_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtPhoneStatus" Text="Desativado" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0"
                                           Text="• Na primeira vez, o Windows pergunta se o NTOobs pode usar a rede. Marque Redes privadas e clique em Permitir."/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                           Text="• O código no endereço impede que outras pessoas da rede controlem a sua live. Se alguém descobrir, clique em Gerar novo código."/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                           Text="• Dica: no navegador do celular, use Adicionar à tela inicial para abrir como um app."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PÁGINA 2: Conexão -->
                <ScrollViewer x:Name="PageConnection" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="24" MaxWidth="1100">
                        <Border Style="{StaticResource CardBorder}" MaxWidth="520" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Conexão com o OBS" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Servidor" Style="{StaticResource CapsText}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtHost"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Porta" Style="{StaticResource CapsText}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtPort"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Senha" Style="{StaticResource CapsText}" Margin="0,12,0,4"/>
                                <PasswordBox x:Name="PwdBox"/>

                                <CheckBox x:Name="ChkAuto" Content="Conectar ao abrir o app" Margin="0,14,0,14"/>
                                <Button x:Name="BtnConnect" Content="Conectar" Style="{StaticResource PrimaryButton}" Click="BtnConnect_Click"/>

                                <TextBlock Style="{StaticResource MutedText}" Margin="0,14,0,0"
                                           Text="No OBS: Ferramentas, Configurações do servidor WebSocket, marque Ativar servidor WebSocket (porta padrão 4455)."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PÁGINA 3: Registro -->
                <Grid x:Name="PageLog" Margin="24" Visibility="Collapsed">
                    <Border Style="{StaticResource CardBorder}" Padding="0">
                        <TextBox x:Name="TxtLog" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" Padding="14"/>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
